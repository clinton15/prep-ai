PORT=8080
MONGO_URI=mongodb://127.0.0.1:27017/prepai
JWT_SECRET=change-me-to-a-long-random-string
# No trailing slash — must match browser Origin exactly
CLIENT_URL=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# AI rate limit (per authenticated user)
GEMINI_RATE_LIMIT_MAX=20
GEMINI_RATE_LIMIT_WINDOW_MS=3600000
# Gemini client resilience
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=2
GEMINI_BACKOFF_MS=800
NODE_ENV=development
